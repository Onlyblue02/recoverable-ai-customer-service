  "reference_date": "2026-07-20",
  "module": "graph",
  "cases": [
    {
      "case_id": "AC-FR08-N-001",
      "title": "人工批准高风险退货后继续执行",
      "case_kind": "functional",
      "polarity": "normal",
      "requirements": ["FR-08"],
      "tags": ["human_approval", "approval_approve", "resume"],
      "preconditions": { "dataset_version": "1.0.0", "reference_date": "2026-07-20", "fixture_refs": { "user_ids": ["USR-DEMO-001", "USR-AGENT-001"], "order_ids": ["ORD-HIGH-VALUE-001"], "policy_ids": ["POL-ACTIVE-STANDARD-001"] }, "initial_state": { "stage": "WAITING_APPROVAL", "approval_status": "PENDING", "risk_reason": "high_value" } },
      "user_input": { "acceptance_basis": "semantic_match", "semantic_intent": "approve_high_risk_return", "required_entities": { "decision": "approve", "actor_id": "USR-AGENT-001" }, "utterance_examples": ["批准这笔高金额退货，备注已核对商品状态。", "审核通过，请按原申请继续处理。"] },
      "expected_process": [
        { "sequence": 1, "event": "commit_approval_decision", "assertions": ["记录处理人、决定、备注和时间", "审批状态从 PENDING 进入终态"] },
        { "sequence": 2, "event": "resume_original_workflow", "assertions": ["从原中断点继续", "幂等创建一次模拟申请"] }
      ],
      "expected_terminal_state": { "terminal_state_id": "TS-FR08-N-001", "status": "COMPLETED", "public_outcome": "批准结果反馈给用户并返回唯一模拟申请。", "must_include": ["人工已批准", "模拟售后申请 ID"], "must_not_include": ["仍等待审批"], "business_effects": { "service_cases_created": 1, "approval_tasks_created": 0 } }
    },
    {
      "case_id": "AC-FR08-E-001",
      "title": "人工调整建议形成明确终态",
      "case_kind": "functional",
      "polarity": "exception",
      "requirements": ["FR-08"],
      "tags": ["human_approval", "approval_adjust"],
      "preconditions": { "dataset_version": "1.0.0", "reference_date": "2026-07-20", "fixture_refs": { "user_ids": ["USR-DEMO-001", "USR-AGENT-001"], "order_ids": ["ORD-HIGH-VALUE-001"] }, "initial_state": { "stage": "WAITING_APPROVAL", "approval_status": "PENDING" } },
      "user_input": { "acceptance_basis": "semantic_match", "semantic_intent": "adjust_approval_recommendation", "required_entities": { "decision": "adjust", "actor_id": "USR-AGENT-001", "recommendation": "先补充商品照片再处理" }, "utterance_examples": ["调整建议：先让用户补充商品照片。", "暂不直接批准，请用户上传相机现状图片。"] },
      "expected_process": [
        { "sequence": 1, "event": "commit_adjusted_decision", "assertions": ["保存结构化调整建议和人工备注"] },
        { "sequence": 2, "event": "request_adjusted_next_step", "assertions": ["不创建售后申请", "向用户反馈需补充照片"] }
      ],
      "expected_terminal_state": { "terminal_state_id": "TS-FR08-E-001", "status": "NEEDS_CLARIFICATION", "public_outcome": "按人工调整建议请求补充商品照片。", "must_include": ["补充商品照片"], "must_not_include": ["已批准", "申请已创建"], "business_effects": { "service_cases_created": 0, "approval_tasks_created": 0 } }
    },
    {
      "case_id": "AC-FR08-E-002",
      "title": "人工拒绝后不创建申请",
      "case_kind": "functional",
      "polarity": "exception",
      "requirements": ["FR-08"],
      "tags": ["human_approval", "approval_reject"],
      "preconditions": { "dataset_version": "1.0.0", "reference_date": "2026-07-20", "fixture_refs": { "user_ids": ["USR-DEMO-001", "USR-AGENT-001"], "order_ids": ["ORD-OVERDUE-001"] }, "initial_state": { "stage": "WAITING_APPROVAL", "approval_status": "PENDING" } },
      "user_input": { "acceptance_basis": "semantic_match", "semantic_intent": "reject_overdue_return", "required_entities": { "decision": "reject", "actor_id": "USR-AGENT-001" }, "utterance_examples": ["拒绝该超期退货，备注不符合特例条件。", "审核不通过，请向用户说明超期原因。"] },
      "expected_process": [
        { "sequence": 1, "event": "commit_rejection", "assertions": ["拒绝决定和备注被保存"] },
        { "sequence": 2, "event": "finish_without_write", "assertions": ["不调用售后申请创建工具"] }
      ],
      "expected_terminal_state": { "terminal_state_id": "TS-FR08-E-002", "status": "REJECTED", "public_outcome": "反馈人工拒绝及可理解原因。", "must_include": ["人工审核未通过", "超期"], "must_not_include": ["售后申请已创建"], "business_effects": { "service_cases_created": 0, "approval_tasks_created": 0 } }
    },
    {
      "case_id": "AC-FR08-E-003",
      "title": "已处理审批拒绝重复修改",
      "case_kind": "safety",
      "polarity": "exception",
      "requirements": ["FR-08"],
      "tags": ["human_approval", "duplicate_approval", "concurrency"],
