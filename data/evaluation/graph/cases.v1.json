        { "sequence": 1, "event": "validate_claim_evidence", "assertions": ["政策、订单、资格和操作声明均有对应依据"] },
        { "sequence": 2, "event": "allow_public_response", "assertions": ["只发送通过校验的公开字段"] }
      ],
      "expected_terminal_state": { "terminal_state_id": "TS-FR09-N-001", "status": "COMPLETED", "public_outcome": "发送有完整依据的申请结果。", "must_include": ["政策来源", "申请状态"], "must_not_include": ["隐藏推理", "未授权字段"], "business_effects": { "service_cases_created": 0, "approval_tasks_created": 0 } }
    },
    {
      "case_id": "AC-FR09-E-001",
