      "case_kind": "safety",
      "polarity": "exception",
      "requirements": ["FR-09"],
      "tags": ["response_gate", "unsupported_answer"],
      "preconditions": { "dataset_version": "1.0.0", "reference_date": "2026-07-20", "fixture_refs": { "product_ids": ["PROD-NO-POLICY-001"] }, "initial_state": { "draft_claim": "定制收藏品支持七天退货", "evidence_ids": [] } },
      "user_input": { "acceptance_basis": "semantic_match", "semantic_intent": "ask_return_policy", "required_entities": { "category": "custom_collectible" }, "utterance_examples": ["定制收藏品能不能退？", "请确认藏品的退货规则。"] },
      "expected_process": [
        { "sequence": 1, "event": "detect_missing_policy_evidence", "assertions": ["确定性结论没有证据 ID"] },
        { "sequence": 2, "event": "block_or_safe_rewrite", "assertions": ["不得发送原草稿", "不得发明政策"] }
      ],
      "expected_terminal_state": { "terminal_state_id": "TS-FR09-E-001", "status": "NEEDS_CLARIFICATION", "public_outcome": "安全改写为缺少依据并提供下一步。", "must_include": ["缺少依据"], "must_not_include": ["支持七天退货"], "business_effects": { "service_cases_created": 0, "approval_tasks_created": 0 } }
    },
    {
      "case_id": "AC-FR09-E-002",
      "title": "没有成功记录的完成声明被拦截",
      "case_kind": "safety",
      "polarity": "exception",
      "requirements": ["FR-09"],
      "tags": ["response_gate", "false_completion"],
      "preconditions": { "dataset_version": "1.0.0", "reference_date": "2026-07-20", "fixture_refs": { "order_ids": ["ORD-NORMAL-001"] }, "initial_state": { "draft_claim": "退货申请已创建", "tool_execution_status": "FAILED_CONFIRMED" } },
      "user_input": { "acceptance_basis": "semantic_match", "semantic_intent": "check_creation_status", "required_entities": { "order_id": "ORD-NORMAL-001" }, "utterance_examples": ["我的退货是不是已经办好了？", "请确认申请到底有没有创建成功。"] },
