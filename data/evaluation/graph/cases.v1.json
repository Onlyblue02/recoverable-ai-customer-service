      "user_input": { "acceptance_basis": "semantic_match", "semantic_intent": "receive_final_return_result", "required_entities": { "order_id": "ORD-NORMAL-001" }, "utterance_examples": ["告诉我这次退货最终处理结果。", "请确认申请是否真的创建成功并给出依据。"] },
