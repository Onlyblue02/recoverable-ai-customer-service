      "user_input": { "acceptance_basis": "semantic_match", "semantic_intent": "repeat_approval_decision", "required_entities": { "decision": "reject", "actor_id": "USR-AGENT-001" }, "utterance_examples": ["把刚才已批准的审批改成拒绝。", "再次提交决定，这次选择不通过。"] },
