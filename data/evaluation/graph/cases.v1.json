        { "sequence": 1, "event": "detect_terminal_approval", "assertions": ["审批已处于 APPROVED 终态"] },
        { "sequence": 2, "event": "reject_duplicate_mutation", "assertions": ["不改变决定", "不重复执行售后写操作"] }
      ],
      "expected_terminal_state": { "terminal_state_id": "TS-FR08-E-003", "status": "COMPLETED", "public_outcome": "返回已有审批与申请结果。", "must_include": ["审批已处理"], "must_not_include": ["决定已改为拒绝", "第二个申请"], "business_effects": { "service_cases_created": 0, "approval_tasks_created": 0 } }
    },
    {
      "case_id": "AC-FR09-N-001",
